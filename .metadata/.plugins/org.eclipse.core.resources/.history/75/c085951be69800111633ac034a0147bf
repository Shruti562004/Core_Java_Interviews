package com.rays.program;

public class PerfectNum {
	
	public static void main(String[] args) {
		int sum=0;
		int num=28;
		
		for(int i=1;i<num;i++) {
			if(num%i==0) {
				sum=sum+i;
				
			}
		}
		
		if(sum==num) {
			System.out.println("perfect num "+num);
			
		}
		
		else {
			System.out.println(" not perfect num "+num);
		}
	}

}
