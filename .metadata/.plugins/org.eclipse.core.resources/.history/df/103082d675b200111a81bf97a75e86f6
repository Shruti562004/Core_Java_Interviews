package com.rays.comparable;

public class FirstLast  implements Comparable<FirstLast>{

	String first;
	String last;
	
	public  FirstLast() {
	this.first=first;
	this.last=last;
	
	}
	@Override
	public int compareTo(FirstLast o) {
	if(this.first.compareTo(o.first)) {
		return this.last.compareTo(o.last);
	}
		return 0;
	}
	
	public String toString() {
		return first + " " + last;
		
		
	}

}
