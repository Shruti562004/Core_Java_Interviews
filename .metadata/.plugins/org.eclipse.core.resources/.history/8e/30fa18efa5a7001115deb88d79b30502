package com.rays.constructor;


class ParentEx {
	
	public ParentEx(int age) {
		
		System.out.println("this is our explicit Constructor... " +age);
	}
	
	
	

}

class ChildEx extends ParentEx{
	
	public ChildEx(int age ,String name) {
        // Java automatically tries super();
		super(age);
        System.out.println(name);
    }
	
}

public class ExplicitCalling {
public static void main(String[] args) {
	ChildEx ex=new ChildEx(3, "chinu");
	
}
}
