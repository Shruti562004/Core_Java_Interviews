package com.rays.program;

public class Prime1to100 {
public static void main(String[] args) {
	
	
	for(int num=2;num<=100;num++) {
		int count=0;
	for(int i=2;i<num;i++) {
		System.out.println();
		
		if(num%i==0) {
			count++;
		
	}
		
	}
	
	if(count==0) {
		System.out.println(num + "prime");
	}
}
}
}
