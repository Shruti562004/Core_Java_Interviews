package com.rays.arrays;

package javabasic;

public class SecondHigh {

    public static void main(String[] args) {

        int[] num = {8, 6, 10, 15, 25};

        int f = 0;
        int s = 0;

        for (int i = 0; i < num.length; i++) {

            if (num[i] > f) {

                s = f;
                f = num[i];

            } else if (num[i] > s) {

                s = num[i];
            }
        }

        System.out.println("Highest = " + f);
        System.out.println("Second Highest = " + s);
    }
}