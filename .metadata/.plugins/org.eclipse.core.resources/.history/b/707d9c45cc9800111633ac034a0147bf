package com.rays.program;

public class Palindrone {
public static void main(String[] args) {
	int num=12121;
	int rev=0,rem;
	int temp=num;
	
	
	while(temp>0) {
	
		rem=temp%10;
		rev=rev*10+rem;
		temp=temp/10;
		
		
	}
	
	if(rev==num) {
		System.out.println("palindrone");
		
	}
	
	else {
		System.out.println("not palindrone");
	}
}
}
