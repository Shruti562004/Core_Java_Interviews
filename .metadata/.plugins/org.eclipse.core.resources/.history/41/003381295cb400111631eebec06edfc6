package com.rays.streamAPI;

import java.util.ArrayList;
import java.util.Collections;
import java.util.List;
import java.util.stream.Collectors;

public class ContenstentTest {
public static void main(String[] args) {
	

	List<Contestent> list = new ArrayList<>();

	list.add(new Contestent("Ram", "9876543212"));
	list.add(new Contestent("Ajay", "881566703982"));
	list.add(new Contestent("Raj", "6268923724"));
	list.add(new Contestent("Prince", "8349516759"));
	list.add(new Contestent("Ram", "1176543212"));
	list.add(new Contestent("Ram", "117678543212"));
	//get phoneno
	list.stream().map(e->e.phoneNo).forEach(System.out::println);
	
	//valid phone
	
	System.out.println("-------------------------------------");
	list.stream().map(e->e.phoneNo).filter(e->e.length()==10).distinct().forEach(System.out::println);
	
	

	System.out.println("-------------------------------------");
	//shuffle random 3
	list.stream().filter(e -> e.phoneNo.length() == 10).distinct()
	.collect(Collectors.collectingAndThen(Collectors.toList(), e -> { //Pehle collect karo, phir collected result par kuch aur operation karo.
		Collections.shuffle(e);
	
		return e.stream();
	})).limit(3).forEach(e -> {
		System.out.println(e.name + " " + e.phoneNo);
	});

	System.out.println("-------------------------------------");
	
}
}


