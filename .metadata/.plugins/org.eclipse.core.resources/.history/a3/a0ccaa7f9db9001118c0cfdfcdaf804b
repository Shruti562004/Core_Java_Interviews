package com.rays.split;

import java.io.BufferedReader;
import java.io.BufferedWriter;
import java.io.FileReader;
import java.io.FileWriter;
import java.io.IOException;

public class TestFileSplit {
	
	public static void main(String[] args) throws IOException {
		
		BufferedReader br=new BufferedReader(new FileReader("D:\\Core_Java_Interviews\\IO\\Shruti.txt"));
		int count=0;
		String check=br.readLine();
		
		while(check!=null) {
			count++;
			check=br.readLine();
		}
		System.out.println("Total Line : " + count);
		BufferedReader br1=new BufferedReader(new FileReader("D:\\Core_Java_Interviews\\IO\\Shruti.txt"));
		
		for(int i=1;i<=count;i++) {
			
			String line=br1.readLine();
			
			System.out.println("createFile" + i + " " + line);
			BufferedWriter w1=new BufferedWriter(new FileWriter("D:\\Core_Java_Interviews\\IO\\Split" +i +".txt"));
			
			w1.write(i);
			
			w1.close();
		}
		
		br.close();
		br1.close();
	}

}
