package com.rays.thread;


class UseRun extends Thread{
	int num=0;
	
	public UseRun(int num) {
		this.num=num;
	}
	public void run() {
		for(int i=0;i<=2;i++) {
			System.out.println(num);
		}
		
	}
	
}
public class WithoutThread {
	
	public static void main(String[] args) {
		UseRun r1=new UseRun(12);
		
	}

}
